{
  "_schema": {
    "name": "nom affiche de l'algorithme",
    "regex": "motif teste avec re.fullmatch sur la valeur normalisee",
    "hashcat": "numero de mode hashcat, ou null si absent",
    "john": "nom du format John the Ripper, ou null",
    "base_score": "precision du MOTIF seule - voir _bareme. La frequence de l'algorithme n'est PAS ici : elle vit dans POPULARITE, dans engine.py",
    "confidence": "unique | ambigu | contexte | faux-ami",
    "exclusive": "true = un match arrete l'evaluation des autres regles",
    "note": "indice de desambiguisation affiche a l'utilisateur"
  },

  "_bareme": {
    "99": "signature unique + exclusive : prefixe litteral, rien d'autre ne matche",
    "90": "signature unique mais non exclusive : motif tres contraint sans prefixe",
    "60": "contexte requis, ou motif large a ne pas laisser remonter trop haut",
    "50": "hex brut : alphabet de 16 caracteres, longueur fixe",
    "30": "alphabet large (base64, 64 caracteres) : motif peu discriminant",
    "regle": "meme valeur pour tout un groupe. Ce qui departage deux algos de meme longueur, c'est POPULARITE dans engine.py, pas ce champ."
  },

  "_ordre": [
    "1. crypt(3) a prefixe        -> exclusive, score 99",
    "2. LDAP et frameworks web    -> exclusive, score 99",
    "3. Cisco                     -> exclusive",
    "4. Bases de donnees          -> exclusive",
    "5. Reseau et authentification-> exclusive",
    "6. Formes composees          -> confidence contexte",
    "7. Faux amis                 -> confidence faux-ami",
    "8. Digests hex bruts         -> par longueur croissante, ambigus",
    "9. Base64                    -> ambigus",
    "Les regles exclusive doivent rester AVANT les regles ambigues."
  ],

